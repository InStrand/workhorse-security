{
  "schema": 1,
  "tools": {
    "gitleaks": {
      "version": "8.30.1",
      "source": "https://github.com/gitleaks/gitleaks",
      "install": "archive",
      "bin": "gitleaks",
      "version_argv": ["version"],
      "artifacts": {
        "linux-x64": {
          "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz",
          "sha256": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
        },
        "linux-arm64": {
          "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_arm64.tar.gz",
          "sha256": "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
        },
        "darwin-arm64": {
          "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz",
          "sha256": "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
        },
        "darwin-x64": {
          "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_x64.tar.gz",
          "sha256": "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
        }
      }
    },
    "zizmor": {
      "version": "1.32.0",
      "source": "https://github.com/zizmorcore/zizmor",
      "install": "archive",
      "bin": "zizmor",
      "version_argv": ["--version"],
      "artifacts": {
        "linux-x64": {
          "url": "https://github.com/zizmorcore/zizmor/releases/download/v1.32.0/zizmor-x86_64-unknown-linux-gnu.tar.gz",
          "sha256": "bb110cc765eca9cd7efb2e284a956be5974c60027b0970f16397d86208a9957b"
        },
        "linux-arm64": {
          "url": "https://github.com/zizmorcore/zizmor/releases/download/v1.32.0/zizmor-aarch64-unknown-linux-gnu.tar.gz",
          "sha256": "cb152b207f815116d7fa1c1ee4614f61578803351395052908095e79adfd9fd0"
        },
        "darwin-arm64": {
          "url": "https://github.com/zizmorcore/zizmor/releases/download/v1.32.0/zizmor-aarch64-apple-darwin.tar.gz",
          "sha256": "6efed18c4539a663fd3c851a2be9533fd8456c4e646d9416206da059154a0d3c"
        },
        "darwin-x64": {
          "url": "https://github.com/zizmorcore/zizmor/releases/download/v1.32.0/zizmor-x86_64-apple-darwin.tar.gz",
          "sha256": "6983143c719ada6845a69cc4dd2bacc215f971662fecd8bbd2678388e5ce5969"
        }
      }
    },
    "semgrep": {
      "version": "1.185.0",
      "source": "https://github.com/semgrep/semgrep",
      "install": "pip",
      "bin": "semgrep",
      "version_argv": ["--version"],
      "requirements": "checks/semgrep/requirements.txt"
    }
  },
  "checks": [
    {
      "id": "gitleaks",
      "finds": "Secrets in commits and files.",
      "class": "deterministic",
      "sends_to": [],
      "tool": "gitleaks",
      "applies": ["**"],
      "canaries": "per-check",
      "neutralise": {
        "replace_files": {
          ".gitleaksignore": "# Written by workhorse-security. The scanned repository does not choose what is skipped.\n"
        }
      },
      "argv": {
        "commits": ["git", "--log-opts={commits}", "{repo}"],
        "tree": ["dir", "."]
      },
      "flags": [
        "--no-banner", "--no-color", "--redact", "--exit-code", "0",
        "--config", "{pack}/checks/gitleaks/gitleaks.toml",
        "--ignore-gitleaks-allow", "--gitleaks-ignore-path", "{pack}/checks/gitleaks",
        "--report-format", "sarif", "--report-path", "{out}"
      ]
    },
    {
      "id": "zizmor",
      "finds": "Unsafe GitHub Actions workflows: triggers that expose secrets, template injection, unpinned actions, broad permissions.",
      "class": "deterministic",
      "sends_to": [],
      "tool": "zizmor",
      "applies": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml",
        ".github/dependabot.yml",
        ".github/dependabot.yaml"
      ],
      "canaries": "per-check",
      "stdout": true,
      "rule_id_strip": "^zizmor/",
      "neutralise": {
        "strip": {
          "paths": [".github/**", "**/action.yml", "**/action.yaml"],
          "regex": "#\\s*zizmor:\\s*ignore\\[[^\\]\\n]*\\]"
        }
      },
      "argv": {
        "tree": ["--format", "sarif", "--offline", "--no-exit-codes", "--no-config", "--no-progress", "."]
      }
    },
    {
      "id": "semgrep",
      "finds": "Breaks of the rules InStrand writes for its own stacks (checks/semgrep/rules).",
      "class": "deterministic",
      "sends_to": [],
      "tool": "semgrep",
      "applies": ["**"],
      "canaries": "per-rule",
      "rule_id_strip": "^.*\\.",
      "neutralise": {
        "replace_files": {
          ".semgrepignore": "# Written by workhorse-security. The scanned repository does not choose what is skipped.\n"
        }
      },
      "argv": {
        "tree": [
          "scan", "--config", "{pack}/checks/semgrep/rules",
          "--sarif", "--output", "{out}",
          "--metrics", "off", "--disable-version-check", "--disable-nosem", "--no-git-ignore", "--quiet",
          "."
        ]
      }
    }
  ]
}
